+		m_pfnThink == static_cast<void (CBaseEntity::*)(void)>(&CBaseToggle::LinearMoveDone) ? 2 : -1;
+	m_iSavedMoveDone = m_pfnCallWhenMoveDone == NULL ? 0 :
+		m_pfnCallWhenMoveDone == static_cast<void (CBaseToggle::*)(void)>(&CFuncTrain::Wait) ? 1 : -1;
