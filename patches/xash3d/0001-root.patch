@@ -814,6 +823,9 @@ def configure(conf):
 	for k in c_config.MACRO_TO_DESTOS:
 		MACRO_TO_DESTOS[k] = c_config.MACRO_TO_DESTOS[k] # ordering is important
 	c_config.MACRO_TO_DESTOS  = MACRO_TO_DESTOS
+	# waf does not know WebAssembly targets, DEST_CPU would be left empty
+	c_config.MACRO_TO_DEST_CPU.setdefault("__wasm32__", "wasm32")
+	c_config.MACRO_TO_DEST_CPU.setdefault("__wasm64__", "wasm64")
 
