@@ -56,8 +56,33 @@ non-zero value will immediately return from it with `error_on_exit`.
 */
 void Host_ExitInMain( void )
 {
+#if XASH_EMSCRIPTEN
+	// Host_Main has already returned to the browser, there is no frame to jump into
+	emscripten_cancel_main_loop();
+	emscripten_force_exit( 0 );
+#else
 	longjmp( return_from_main_buf, 1 );
+#endif
+}
+
+#if XASH_EMSCRIPTEN
+static double emscripten_oldtime;
+
+static void Host_EmscriptenFrame( void )
+{
+	double newtime;
+
+	if( host.status == HOST_CRASHED )
+	{
+		emscripten_cancel_main_loop();
+		return;
+	}
+
+	newtime = Platform_DoubleTime();
+	COM_Frame( newtime - emscripten_oldtime );
+	emscripten_oldtime = newtime;
 }
+#endif // XASH_EMSCRIPTEN
 
 #ifdef XASH_ENGINE_TESTS
 struct tests_stats_s tests_stats;
@@ -1337,6 +1362,11 @@ int EXPORT Host_Main( int argc, char **argv, const char *progname, int bChangeGa
 	// check after all configs were executed
 	HPAK_CheckIntegrity( hpk_custom_file.string );
 
+#if XASH_EMSCRIPTEN
+	// the browser owns the main loop: run one engine frame per animation frame
+	emscripten_oldtime = oldtime;
+	emscripten_set_main_loop( Host_EmscriptenFrame, 0, false );
+#else // !XASH_EMSCRIPTEN
 	// main window message loop
 	while( host.status != HOST_CRASHED )
 	{
@@ -1344,6 +1374,7 @@ int EXPORT Host_Main( int argc, char **argv, const char *progname, int bChangeGa
