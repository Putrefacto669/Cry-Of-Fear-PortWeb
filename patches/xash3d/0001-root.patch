+				c[0] = R_CofCurve( 2.0f * ( a->r + d->r * z ) / 255.0f ) * 0.5f;
+				c[1] = R_CofCurve( 2.0f * ( a->g + d->g * z ) / 255.0f ) * 0.5f;
+				c[2] = R_CofCurve( 2.0f * ( a->b + d->b * z ) / 255.0f ) * 0.5f;
