diff --git a/ref/gl/gl_rsurf.c b/ref/gl/gl_rsurf.c
index 18dea062..ee668d3e 100644
--- a/ref/gl/gl_rsurf.c
+++ b/ref/gl/gl_rsurf.c
@@ -38,6 +38,254 @@ typedef struct
 static vec2_t		world_orthocenter;
 static vec2_t		world_orthohalf;
 static uint		r_blocklights[BLOCK_SIZE_MAX*BLOCK_SIZE_MAX*3];
+
+/*
+=============================================================
+
+Cry of Fear flashlight. The original client.dll (Paranoia's renderer)
+projects gfx/flashlight.tga from the view as a spotlight and adds it
+to the lighting in a second pass (glBlendFunc GL_DST_ALPHA, GL_ONE):
+colour * cookie * (1 - t*t) * N.L, where t is the distance along the
+axis over the radius, inside a frustum of r_cofspot_fov degrees. The
+client (cof_client.cpp) marks that light with COF_SPOT_KEY; here it
+is added to each luxel after the gamma table, as the original adds it
+on top of the lightmapped surface.
+
+=============================================================
+*/
+static float	r_spotlight[BLOCK_SIZE_MAX*BLOCK_SIZE_MAX*3];
+static qboolean	r_spotused;
+static rgbdata_t	*r_spotcookie;
+static qboolean	r_spotcookietried;
+static cvar_t	*r_cofspot_fov;
+static cvar_t *r_cofspot_debug;
+static struct {
+ int frame, channels, clipped;
+ double requested, retained, base, lightmapMs, spotMs;
+} r_spotstats;
+
+static void R_CofSpotStats( void )
+{
+ gEngfuncs.Con_Printf( "COF/SPOT enabled=%d frame=%d renderframe=%d channels=%d clipped=%d requested=%g retained=%g base=%g cookie=%dx%d bytes=%zu lightmapMs=%g spotMs=%g\n",
+  r_cofspot_debug && r_cofspot_debug->value != 0, r_spotstats.frame, tr.framecount,
+  r_spotstats.channels, r_spotstats.clipped, r_spotstats.requested, r_spotstats.retained, r_spotstats.base,
+  r_spotcookie ? r_spotcookie->width : 0, r_spotcookie ? r_spotcookie->height : 0, r_spotcookie ? r_spotcookie->size : 0, r_spotstats.lightmapMs, r_spotstats.spotMs );
+}
+
+// Opt-in telemetry only; the composition below keeps its existing arithmetic.
+static void R_CofSpotObserve( int base, int addition )
+{
+ if( !r_cofspot_debug || !r_cofspot_debug->value || addition <= 0 ) return;
+ if( r_spotstats.frame != tr.framecount ) {
+  memset( &r_spotstats, 0, sizeof( r_spotstats ));
+  r_spotstats.frame = tr.framecount;
+ }
+ r_spotstats.channels++;
+ r_spotstats.clipped += base + addition > 255;
+ r_spotstats.requested += addition;
+ r_spotstats.retained += Q_min( addition, 255 - base );
+ r_spotstats.base += base;
+}
+
+
+static void R_SpotCookie( float u, float v, vec3_t out )
+{
+	if( !r_spotcookietried )
+	{
+		r_spotcookietried = true;
+		r_spotcookie = gEngfuncs.FS_LoadImage( "gfx/flashlight.tga", NULL, 0 );
+	}
+
+	if( !r_spotcookie || !r_spotcookie->buffer || !r_spotcookie->width || !r_spotcookie->height )
+	{
+		VectorSet( out, 1.0f, 1.0f, 1.0f );
+		return;
+	}
+
+	int w = r_spotcookie->width, h = r_spotcookie->height;
+	int bpp = r_spotcookie->size / ( w * h );
+	int x = bound( 0, (int)( u * ( w - 1 ) + 0.5f ), w - 1 );
+	int y = bound( 0, (int)( v * ( h - 1 ) + 0.5f ), h - 1 );
+	const byte *p = r_spotcookie->buffer + ( y * w + x ) * bpp;
+
+	if( bpp >= 3 )
+		VectorSet( out, p[0] / 255.0f, p[1] / 255.0f, p[2] / 255.0f );
+	else
+		VectorSet( out, p[0] / 255.0f, p[0] / 255.0f, p[0] / 255.0f );
+}
+
+static float R_SpotTan( void )
+{
+ if( !r_cofspot_debug ) {
+  r_cofspot_debug = gEngfuncs.Cvar_Get( "r_cofspot_debug", "0", 0, "Record Cry of Fear spotlight lightmap saturation" );
+  gEngfuncs.Cmd_AddCommand( "cof_spot_stats", R_CofSpotStats, "Inspect the last spotlight lightmap composition frame" );
+ }
+
+	if( !r_cofspot_fov )
+		r_cofspot_fov = gEngfuncs.pfnGetCvarPointer( "r_cofspot_fov" );
+	float fov = r_cofspot_fov ? r_cofspot_fov->value : 50.0f;
+	return tan( DEG2RAD( bound( 1.0f, fov, 170.0f ) * 0.5f ));
+}
+
+// cookie * attenuation at a point in the space of org/fwd/rgt/up; 0 outside the frustum
+static float R_SpotAt( const vec3_t d, const vec3_t fwd, const vec3_t rgt, const vec3_t up,
+	float radius, float tanh, vec3_t cookie )
+{
+	float along = DotProduct( d, fwd );
+	if( along <= 1.0f || along >= radius )
+		return 0.0f;
+
+	float x = DotProduct( d, rgt ) / ( along * tanh );
+	float y = DotProduct( d, up ) / ( along * tanh );
+	if( x <= -1.0f || x >= 1.0f || y <= -1.0f || y >= 1.0f )
+		return 0.0f;
+
+	float t = along / radius;
+	R_SpotCookie(( x + 1.0f ) * 0.5f, ( 1.0f - y ) * 0.5f, cookie );
+	return 1.0f - t * t;
+}
+
+// for models (gl_studio.c): the strength of the spotlight at a point, and its tint there
+float R_CofSpotFactorFrom( const vec3_t apex, const vec3_t point, vec3_t color )
+{
+	vec3_t d;
+	VectorSubtract( point, apex, d );
+	float k = R_SpotAt( d, RI.vforward, RI.vright, RI.vup, 700.0f, R_SpotTan(), color );
+	VectorScale( color, k, color );
+	return k;
+}
+
+float R_CofSpotFactor( const vec3_t point, vec3_t color )
+{
+	return R_CofSpotFactorFrom( RI.rvp.vieworigin, point, color );
+}
+
+// the flashlight's aperture in degrees (r_cofspot_fov, 50 by default), for the models (gl_studio.c)
+float R_CofSpotFov( void )
+{
+	R_SpotTan(); // finds r_cofspot_fov
+	return bound( 1.0f, r_cofspot_fov ? r_cofspot_fov->value : 50.0f, 170.0f );
+}
+
+// whether the spotlight's volume from 'apex' can reach the box: the original tests the cone's volume against the
+// model's box before the light takes one of the model's 4 slots (client.dll 10084e40 builds it, 10084b30 tests
+// it): four side planes through the light, the forward axis turned by +-( 90 - aperture / 2 ) about up and
+// right, and a far plane through apex + forward * radius (700 here, the reach of R_SpotAt). There is no near
+// plane. A box entirely behind one plane is rejected (10083e90), as in a frustum cull.
+qboolean R_CofSpotTouchesBox( const vec3_t apex, const vec3_t mins, const vec3_t maxs )
+{
+	const float half = DEG2RAD( R_CofSpotFov() * 0.5f );
+	vec3_t normals[5];
+	float dists[5];
+
+	VectorNegate( RI.vforward, normals[0] ); dists[0] = -( DotProduct( RI.vforward, apex ) + 700.0f );
+	for( int side = 0; side < 4; side++ )
+	{
+		const float *axis = side < 2 ? RI.vright : RI.vup;
+		const float sign = ( side & 1 ) ? 1.0f : -1.0f;
+		for( int k = 0; k < 3; k++ )
+			normals[1 + side][k] = RI.vforward[k] * sinf( half ) + sign * axis[k] * cosf( half );
+		dists[1 + side] = DotProduct( normals[1 + side], apex );
+	}
+
+	for( int p = 0; p < 5; p++ )
+	{
+		qboolean inside = false;
+		for( int c = 0; c < 8 && !inside; c++ )
+		{
+			vec3_t corner = { ( c & 1 ) ? maxs[0] : mins[0], ( c & 2 ) ? maxs[1] : mins[1], ( c & 4 ) ? maxs[2] : mins[2] };
+			inside = DotProduct( normals[p], corner ) >= dists[p];
+		}
+		if( !inside )
+			return false;
+	}
+	return true;
+}
