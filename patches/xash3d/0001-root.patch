+static void R_AddSpotLight( const msurface_t *surf, const dlight_t *dl, float sample_size, int smax, int tmax )
+{
+	const mextrasurf_t *info = surf->info;
+	vec3_t org, fwd, rgt, up, normal, U, V, W, p00, ds, dt;
+	float tanh = R_SpotTan();
+	double cof_spot_start = r_cofspot_debug && r_cofspot_debug->value ? gEngfuncs.pfnTime() : 0;
+	float color[3] = { dl->color.r / 255.0f, dl->color.g / 255.0f, dl->color.b / 255.0f };
+
+	// the view in the space of the model being drawn (brush entities)
+	if( !tr.modelviewIdentity )
+	{
+		Matrix4x4_VectorITransform( RI.objectMatrix, RI.rvp.vieworigin, org );
+		Matrix4x4_VectorIRotate( RI.objectMatrix, RI.vforward, fwd );
+		Matrix4x4_VectorIRotate( RI.objectMatrix, RI.vright, rgt );
+		Matrix4x4_VectorIRotate( RI.objectMatrix, RI.vup, up );
+	}
+	else
+	{
+		VectorCopy( RI.rvp.vieworigin, org );
+		VectorCopy( RI.vforward, fwd );
+		VectorCopy( RI.vright, rgt );
+		VectorCopy( RI.vup, up );
+	}
+
+	// the face looks away from the light
+	VectorCopy( surf->plane->normal, normal );
+	float side = DotProduct( org, surf->plane->normal ) - surf->plane->dist;
+	if( FBitSet( surf->flags, SURF_PLANEBACK ))
+	{
+		VectorNegate( normal, normal );
+		side = -side;
+	}
+	if( side <= 0.0f )
+		return;
+
+	// luxel (s, t) -> point on the plane: invert the lightmap vectors with the plane
+	CrossProduct( info->lmvecs[1], surf->plane->normal, U );
+	CrossProduct( surf->plane->normal, info->lmvecs[0], V );
+	CrossProduct( info->lmvecs[0], info->lmvecs[1], W );
+	float det = DotProduct( info->lmvecs[0], U );
+	if( fabs( det ) < 1e-6f )
+		return;
+	VectorScale( U, 1.0f / det, U );
+	VectorScale( V, 1.0f / det, V );
+	VectorScale( W, 1.0f / det, W );
+
+	float a0 = info->lightmapmins[0] - info->lmvecs[0][3];
+	float b0 = info->lightmapmins[1] - info->lmvecs[1][3];
+	VectorScale( U, a0, p00 );
+	VectorMA( p00, b0, V, p00 );
+	VectorMA( p00, surf->plane->dist, W, p00 );
+	VectorScale( U, sample_size, ds );
+	VectorScale( V, sample_size, dt );
+
+	if( !r_spotused )
+	{
+		memset( r_spotlight, 0, sizeof( float ) * smax * tmax * 3 );
+		r_spotused = true;
+	}
+
+	for( int t = 0; t < tmax; t++ )
+	{
+		for( int s = 0; s < smax; s++ )
+		{
+			vec3_t p, d, cookie;
+			VectorMA( p00, s, ds, p );
+			VectorMA( p, t, dt, p );
+			VectorSubtract( p, org, d );
+
+			float k = R_SpotAt( d, fwd, rgt, up, dl->radius, tanh, cookie );
+			if( k <= 0.0f )
+				continue;
+
+			float ndl = -DotProduct( d, normal ) / VectorLength( d );
+			if( ndl <= 0.0f )
+				continue;
+
+			float *out = &r_spotlight[(s + t * smax) * 3];
+			for( int i = 0; i < 3; i++ )
+				out[i] += k * ndl * cookie[i] * color[i];
+		}
+	}
+	if( cof_spot_start ) r_spotstats.spotMs += ( gEngfuncs.pfnTime() - cof_spot_start ) * 1000.0;
+}
