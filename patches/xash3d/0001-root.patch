diff --git a/engine/client/sound/s_webaudio.c b/engine/client/sound/s_webaudio.c
new file mode 100755
index 00000000..b4dc6488
--- /dev/null
+++ b/engine/client/sound/s_webaudio.c
@@ -0,0 +1,359 @@
+/*
+s_webaudio.c - game sound channels played through Web Audio with 3D panning (Emscripten only)
+Copyright (C) 2026 Xash3D FWGS contributors
+
+This program is free software: you can redistribute it and/or modify
+it under the terms of the GNU General Public License as published by
+the Free Software Foundation, either version 3 of the License, or
+(at your option) any later version.
+
+This program is distributed in the hope that it will be useful,
+but WITHOUT ANY WARRANTY; without even the implied warranty of
+MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
+GNU General Public License for more details.
+*/
+
+#include "common.h"
+#include "client.h"
+#include "sound.h"
+
+#if XASH_EMSCRIPTEN
+#include <emscripten/emscripten.h>
+
+/*
+Every regular game channel becomes a Web Audio voice:
+
+	AudioBufferSourceNode -> GainNode (channel volume) -> PannerNode (world sounds only) -> bus -> master
+
+The engine mixer skips these channels (WebAudio_OwnsChannel) and keeps everything Web Audio
+cannot take over cleanly: sentences (VOX words are loaded one by one while mixing), CHAN_VOICE
+(the mixer drives lip sync from the samples it reads) and raw streams (music, voice chat, movies).
+
+The PCM data is uploaded once per wavdata_t and shared by every voice playing it.
+GoldSrc attenuation, gain = 1 - distance * (attn / SND_CLIP_DISTANCE), is exactly the Web Audio
+"linear" distance model with refDistance 0 and maxDistance SND_CLIP_DISTANCE / attn.
+Quake coordinates (x forward, y left, z up) are right-handed like Web Audio, so positions and
+the listener basis are passed unchanged.
+*/
+
+static CVAR_DEFINE_AUTO( snd_webaudio, "1", FCVAR_ARCHIVE, "play game sounds through Web Audio with 3D panning (0 = engine mixer)" );
+static CVAR_DEFINE_AUTO( snd_webaudio_hrtf, "1", FCVAR_ARCHIVE, "use HRTF panning for world sounds (0 = equal power, cheaper)" );
+
+// Web Audio voice id + 1 per channel. Kept outside channel_t on purpose: S_StartSound memsets
+// a reused channel before notifying, which would lose the id and leave the voice playing.
+static int wa_voice[MAX_CHANNELS];
+#define WA_VOICE( ch ) ( wa_voice[( ch ) - snd.channels] )
+
+static qboolean wa_initialized;
+
+EM_JS( int, WA_JS_Init, ( int hrtf ), {
+	const AC = globalThis.AudioContext || globalThis.webkitAudioContext;
+	if( !AC ) return 0;
+	const ctx = new AC({ latencyHint: "interactive" });
+	const master = ctx.createGain();
+	const world = ctx.createGain(); // paused together with the game
+	const ui = ctx.createGain();    // menu and local sounds keep playing
+	world.connect( master );
+	ui.connect( master );
+	master.connect( ctx.destination );
+	const resume = () => { if( ctx.state !== "running" ) ctx.resume(); };
+	for( const ev of [ "pointerdown", "keydown", "touchstart" ] )
+		addEventListener( ev, resume, { capture: true });
+	Module.cofAudio = { ctx, master, world, ui, hrtf: !!hrtf, buffers: new Map(), voices: new Map(), nextId: 1 };
+	return 1;
+});
+
+EM_JS( int, WA_JS_HasBuffer, ( int key ), {
+	return Module.cofAudio.buffers.has( key ) ? 1 : 0;
+});
+
+// data: interleaved signed PCM, 8 or 16 bit
+EM_JS( void, WA_JS_UploadBuffer, ( int key, const void *data, int frames, int rate, int width, int channels ), {
+	const a = Module.cofAudio;
+	const buf = a.ctx.createBuffer( channels, frames, rate );
+	const src = width === 1 ? HEAP8.subarray( data, data + frames * channels )
+		: HEAP16.subarray( data >> 1, ( data >> 1 ) + frames * channels );
+	const scale = width === 1 ? 1 / 128 : 1 / 32768;
+	for( let c = 0; c < channels; c++ )
+	{
+		const out = buf.getChannelData( c );
+		for( let i = 0, j = c; i < frames; i++, j += channels )
+			out[i] = src[j] * scale;
+	}
+	a.buffers.set( key, buf );
+});
+
+EM_JS( void, WA_JS_FreeBuffer, ( int key ), {
+	if( Module.cofAudio ) Module.cofAudio.buffers.delete( key );
+});
+
+EM_JS( int, WA_JS_Play, ( int key, float volume, float rate, int loop, float loop_start, float offset,
+	int positional, int ui, float x, float y, float z, float max_dist ), {
+	const a = Module.cofAudio;
+	const buffer = a.buffers.get( key );
+	if( !buffer ) return 0;
+	const src = a.ctx.createBufferSource();
+	src.buffer = buffer;
+	src.playbackRate.value = rate;
+	if( loop )
+	{
+		src.loop = true;
+		src.loopStart = loop_start;
+		src.loopEnd = buffer.duration;
+	}
+	const gain = a.ctx.createGain();
+	gain.gain.value = volume;
+	src.connect( gain );
+
+	let panner = null;
+	if( positional )
+	{
+		panner = a.ctx.createPanner();
+		panner.panningModel = a.hrtf ? "HRTF" : "equalpower";
+		panner.distanceModel = "linear";
+		panner.refDistance = 0;
+		panner.maxDistance = max_dist > 0 ? max_dist : 10000;
+		panner.rolloffFactor = max_dist > 0 ? 1 : 0;
+		panner.positionX.value = x;
+		panner.positionY.value = y;
+		panner.positionZ.value = z;
+		gain.connect( panner );
+		panner.connect( ui ? a.ui : a.world );
+	}
+	else
+	{
+		gain.connect( ui ? a.ui : a.world );
+	}
+
+	const id = a.nextId++;
+	const voice = { src, gain, panner, ended: false };
+	src.onended = () => { voice.ended = true; };
+	src.start( 0, offset );
+	a.voices.set( id, voice );
+	return id;
+});
+
+EM_JS( void, WA_JS_Update, ( int id, float volume, float rate, float x, float y, float z ), {
+	const a = Module.cofAudio;
+	const v = a.voices.get( id );
+	if( !v ) return;
+	const t = a.ctx.currentTime;
+	// short time constants: no zipper noise, still tracks fast movers
+	v.gain.gain.setTargetAtTime( volume, t, 0.015 );
+	v.src.playbackRate.setTargetAtTime( rate, t, 0.015 );
+	if( v.panner )
+	{
+		v.panner.positionX.setTargetAtTime( x, t, 0.02 );
+		v.panner.positionY.setTargetAtTime( y, t, 0.02 );
+		v.panner.positionZ.setTargetAtTime( z, t, 0.02 );
+	}
+});
+
+EM_JS( int, WA_JS_Ended, ( int id ), {
+	const v = Module.cofAudio.voices.get( id );
+	return !v || v.ended ? 1 : 0;
+});
+
+EM_JS( void, WA_JS_Stop, ( int id ), {
+	const a = Module.cofAudio;
+	const v = a.voices.get( id );
+	if( !v ) return;
+	v.src.onended = null;
+	try { v.src.stop(); } catch( e ) {}
+	v.src.disconnect();
+	v.gain.disconnect();
+	if( v.panner ) v.panner.disconnect();
+	a.voices.delete( id );
+});
+
+EM_JS( void, WA_JS_Listener, ( float ox, float oy, float oz, float fx, float fy, float fz,
+	float ux, float uy, float uz, float master, int world_paused ), {
+	const a = Module.cofAudio;
+	const l = a.ctx.listener;
+	const t = a.ctx.currentTime;
+	if( l.positionX )
+	{
+		l.positionX.setTargetAtTime( ox, t, 0.02 );
+		l.positionY.setTargetAtTime( oy, t, 0.02 );
+		l.positionZ.setTargetAtTime( oz, t, 0.02 );
+		l.forwardX.setTargetAtTime( fx, t, 0.02 );
+		l.forwardY.setTargetAtTime( fy, t, 0.02 );
+		l.forwardZ.setTargetAtTime( fz, t, 0.02 );
+		l.upX.setTargetAtTime( ux, t, 0.02 );
+		l.upY.setTargetAtTime( uy, t, 0.02 );
+		l.upZ.setTargetAtTime( uz, t, 0.02 );
+	}
+	else // Firefox < 99 / old Safari
+	{
+		l.setPosition( ox, oy, oz );
+		l.setOrientation( fx, fy, fz, ux, uy, uz );
+	}
+	a.master.gain.setTargetAtTime( master, t, 0.05 );
+	a.world.gain.setTargetAtTime( world_paused ? 0 : 1, t, 0.05 );
+});
+
+EM_JS( void, WA_JS_SetHRTF, ( int hrtf ), {
+	Module.cofAudio.hrtf = !!hrtf;
+});
+
+/*
+=================
+WebAudio_OwnsChannel
+
+the mixer skips channels played by Web Audio
+=================
+*/
+qboolean WebAudio_OwnsChannel( const channel_t *ch )
+{
+	return WA_VOICE( ch ) != 0;
+}
+
+static qboolean WebAudio_IsPositional( const channel_t *ch )
+{
+	if( FBitSet( ch->flags, FL_CHAN_LOCAL_SOUND ))
+		return false;
+
+	// the view entity hears its own sounds at full volume, see SND_Spatialize
+	return ch->entnum != snd.entnum;
+}
+
+static float WebAudio_ChannelVolume( const channel_t *ch )
+{
+	// GoldSrc channel volume is 0..255
+	return ch->master_vol / 255.0f;
+}
+
+static void WebAudio_Stop( channel_t *ch )
+{
+	if( !WA_VOICE( ch ))
+		return;
+
+	WA_JS_Stop( (int)WA_VOICE( ch ) - 1 );
+	WA_VOICE( ch ) = 0;
+}
+
+/*
+=================
+WebAudio_ChannelUpdate
+
+called whenever the engine starts (ch != NULL) or frees (ch == NULL) a channel
+=================
+*/
+void WebAudio_ChannelUpdate( int ch_idx, const channel_t *cch )
+{
+	channel_t *ch = &snd.channels[ch_idx];
+	const wavdata_t *wav;
+	qboolean positional;
+	float max_dist = 0.0f;
+	int key, voice;
+
+	if( !wa_initialized )
+		return;
+
+	WebAudio_Stop( ch );
+
+	if( !cch || !snd_webaudio.value )
+		return;
+
+	// left to the engine mixer, see the comment at the top
+	if( ch->words || ch->entchannel == CHAN_VOICE || !ch->sfx || !( wav = ch->sfx->cache ))
+		return;
+
+	if( wav->width != 1 && wav->width != 2 )
+		return;
+
+	key = (int)(uintptr_t)wav;
+	if( !WA_JS_HasBuffer( key ))
+		WA_JS_UploadBuffer( key, wav->buffer, wav->samples, wav->rate, wav->width, wav->channels );
+
+	positional = WebAudio_IsPositional( ch );
+	if( ch->dist_mult > 0.0f )
+		max_dist = 1.0f / ch->dist_mult;
+
+	voice = WA_JS_Play( key, WebAudio_ChannelVolume( ch ), ch->basePitch * 0.01f,
+		FBitSet( wav->flags, SOUND_LOOPED ) && FBitSet( ch->flags, FL_CHAN_USE_LOOP ),
+		(float)wav->loop_start / wav->rate, (float)( ch->sample / wav->rate ),
+		positional, FBitSet( ch->flags, FL_CHAN_LOCAL_SOUND ),
+		ch->origin[0], ch->origin[1], ch->origin[2], max_dist );
+
+	if( voice > 0 )
+		WA_VOICE( ch ) = voice + 1;
+}
+
+/*
+=================
+WebAudio_FreeSound
+
+the PCM is about to be freed, drop the uploaded copy
+=================
+*/
+void WebAudio_FreeSound( const sfx_t *sfx )
+{
+	if( wa_initialized && sfx && sfx->cache )
+		WA_JS_FreeBuffer( (int)(uintptr_t)sfx->cache );
+}
+
+/*
+=================
+WebAudio_Update
+
+once per frame after the engine spatialized every channel: move the listener and the voices,
+release channels whose voice finished
+=================
+*/
+void WebAudio_Update( void )
+{
+	qboolean world_paused;
+
+	if( !wa_initialized )
+		return;
+
+	if( FBitSet( snd_webaudio_hrtf.flags, FCVAR_CHANGED ))
+	{
+		WA_JS_SetHRTF( snd_webaudio_hrtf.value != 0.0f );
+		ClearBits( snd_webaudio_hrtf.flags, FCVAR_CHANGED );
+	}
+
+	// same rule as the mixer: in the menu or paused only local sounds go on
+	world_paused = !cl.background && ( cls.key_dest == key_menu || cl.paused ) && Host_IsSinglePlayerGame();
+
+	WA_JS_Listener( snd.origin[0], snd.origin[1], snd.origin[2],
+		snd.forward[0], snd.forward[1], snd.forward[2],
+		snd.up[0], snd.up[1], snd.up[2],
+		S_GetMasterVolume(), world_paused );
+
+	for( int i = 0; i < snd.total_channels; i++ )
+	{
+		channel_t *ch = &snd.channels[i];
+		int voice;
+
+		if( !WA_VOICE( ch ))
+			continue;
+
+		voice = (int)WA_VOICE( ch ) - 1;
+
+		if( !ch->sfx || WA_JS_Ended( voice ))
+		{
+			// finished one-shot: release it like the mixer does at the end of the samples
+			S_FreeChannel( ch );
+			continue;
+		}
+
+		// SND_Spatialize already refreshed ch->origin from the entity; zero volume there means
+		// the entity is gone from the client, mute the voice instead of letting it play on
+		WA_JS_Update( voice,
+			( ch->leftvol || ch->rightvol || !WebAudio_IsPositional( ch )) ? WebAudio_ChannelVolume( ch ) : 0.0f,
+			ch->basePitch * 0.01f, ch->origin[0], ch->origin[1], ch->origin[2] );
+	}
+}
+
+void WebAudio_Init( void )
+{
+	Cvar_RegisterVariable( &snd_webaudio );
+	Cvar_RegisterVariable( &snd_webaudio_hrtf );
+
+	wa_initialized = WA_JS_Init( snd_webaudio_hrtf.value != 0.0f );
+	Con_Printf( "Web Audio: %s\n", wa_initialized ? "3D channels enabled" : "not available, using the engine mixer" );
+}
+
+#endif // XASH_EMSCRIPTEN
diff --git a/engine/common/host.c b/engine/common/host.c
