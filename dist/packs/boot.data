Spec_Duck
{
Press DUCK for Spectator Menu
}
// load the base configuration
//exec default.cfg

s_refgain 0.4
s_refdelay 4
s_occfactor 0.25
s_verbwet 0.25
s_distance 60


// load the language configuration
exec language.cfg

// Setup custom controller
exec joystick.cfg

// run a user script file if present
exec autoexec.cfg

//
// stuff command line statements
//
stuffcmds

