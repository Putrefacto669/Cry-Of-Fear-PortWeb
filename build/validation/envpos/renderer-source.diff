+
 qboolean R_AddEntity( struct cl_entity_s *clent, int type )
 {
+	if( R_CoFSkyEntity(clent) && !R_CoFSkyConfigured() ) return true;
+
 	if( !r_drawentities->value )
 		return false; // not allow to drawing
 
@@ -292,6 +296,74 @@ qboolean R_AddEntity( struct cl_entity_s *clent, int type )
 R_Clear
 =============
